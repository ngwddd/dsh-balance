{
  "name": "@local/ds-balance",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "简约 · DSH 余额：悬浮球显示余额，点开看今日用量、花费与峰谷时段。",
  "keywords": ["dsh", "deepseek", "balance", "plugin"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test-spend.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
